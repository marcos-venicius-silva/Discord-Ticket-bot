# Token do bot (Discord Developer Portal)
DISCORD_TOKEN=SEU_TOKEN_AQUI

# Client ID da aplicação (Discord Developer Portal)
CLIENT_ID=SEU_CLIENT_ID_AQUI

# String de conexão do MongoDB (Atlas ou local)
MONGODB_URI=mongodb://localhost:27017/ticket-bot

# ID de um servidor para registrar comandos apenas nele durante o desenvolvimento (opcional)
# Deixe vazio para registrar comandos globalmente (pode levar até 1h para propagar)
DEV_GUILD_ID=

# Cor padrão usada em embeds do sistema (hexadecimal, sem #)
DEFAULT_EMBED_COLOR=2B2D31
